\name{agriGLMflow-package}
\alias{agriGLMflow-package}
\alias{agriGLMflow}
\title{agriGLMflow: Design-aware generalized modelling for agricultural experiments}
\description{A unified, auditable workflow for generalized linear models, generalized linear mixed models, GAMLSS, VGAM, ordinal, compositional and quantitative-treatment regression in agricultural research.}
\details{The package treats the experimental design, response support and dependence structure as constraints that must be preserved before model-family and engine selection. Automated workflows do not select models solely by P values or information criteria.}
\seealso{\code{agri_workflow()}, \code{agri_design()}, \code{agri_family_scan()}, \code{agri_model()}}
